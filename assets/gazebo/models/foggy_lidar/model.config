<?xml version="1.0"?>
<model>
  <name>foggy_lidar</name>
  <version>1.0</version>
  <sdf version="1.5">model.sdf</sdf>
  <author>
    <name>PX4 Autopilot contributors, ROS 2 Gazebo plugin compatibility overlay by this repository</name>
  </author>
  <description>
    Compatibility overlay for PX4 Gazebo Classic foggy_lidar. The ray sensor
    geometry is kept from PX4 release/1.14, while the ROS output plugin is
    switched to gazebo_ros_ray_sensor from ROS 2 Humble.
  </description>
</model>

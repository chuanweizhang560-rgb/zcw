<?xml version="1.0"?>
<model>
  <name>iris_depth_camera</name>
  <version>1.0</version>
  <sdf version="1.5">iris_depth_camera.sdf</sdf>
  <author>
    <name>PX4 Autopilot contributors, ROS 2 Gazebo plugin compatibility overlay by this repository</name>
  </author>
  <description>
    Compatibility overlay for PX4 Gazebo Classic iris_depth_camera. The Iris
    vehicle and depth camera geometry remain PX4 release/1.14 includes; this
    overlay only adds gazebo_ros_p3d for the camera link pose.
  </description>
</model>

Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Grid1
        - /Offset Path1
        - /Lookahead Target1
        - /Dry Run Path1
        - /Dry Run Candidate1
        - /PX4 Bridge NED Dry Run1
      Splitter Ratio: 0.5
    Tree Height: 549
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 10
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 160
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 25; 190; 80
      Enabled: true
      Line Style: Lines
      Line Width: 0.22
      Name: Offset Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 25; 190; 80
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /zcw/cable/offset_path
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointStamped
      Color: 230; 60; 40
      Enabled: true
      History Length: 20
      Name: Lookahead Target
      Radius: 1.4
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /zcw/cable/lookahead_target
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 45; 130; 230
      Enabled: true
      Line Style: Lines
      Line Width: 0.32
      Name: Dry Run Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 45; 130; 230
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /zcw/cable/dry_run/path
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointStamped
      Color: 245; 200; 35
      Enabled: true
      History Length: 20
      Name: Dry Run Candidate
      Radius: 1.8
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /zcw/cable/dry_run/candidate_setpoint
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointStamped
      Color: 190; 80; 245
      Enabled: true
      History Length: 20
      Name: PX4 Bridge NED Dry Run
      Radius: 2.0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /zcw/cable/px4_bridge/ned_setpoint_dry_run
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 24; 28
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 190
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: -45
        Y: 12
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.65
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 4.71
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Views:
    collapsed: false
  Width: 1200
  X: 80
  Y: 80
